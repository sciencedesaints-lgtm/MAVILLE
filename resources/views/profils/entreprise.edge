        <li>📈 Statistiques</li>
      </ul>
    </aside>

    <main class="main-content">
      <header class="dashboard-header">
        <div class="user-profile-summary" style="display: flex; align-items: center; gap: 15px;">
          <img src="{{ user.avatar || '/images/default-avatar.png' }}" alt="Logo Entreprise" style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover; border: 2px solid #10b981;" />
          <div>
            <h1>Espace Professionnel : <span id="user-name">{{ user.nom }} {{ user.prenom ? '(' + user.prenom + ')' : '' }}</span></h1>
