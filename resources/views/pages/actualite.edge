  </style>

  <div class="maville-layout">

    <aside class="sidebar">
      <div class="sidebar-menu">
        <div class="logo" style="margin-bottom: 25px; padding-left: 10px;">MAVILLE</div>
        <a href="{{ route('web.accueil') }}" class="nav-item"><span>🏠</span> Accueil</a>
        <a href="{{ route('profil.personnel') }}" class="nav-item"><span>👤</span> Profil</a>
        <a href="{{ route('web.actualite') }}" class="nav-item active"><span>📰</span> Actualité</a>
        <a href="{{ route('notifications.index') }}" class="nav-item"><span>🔔</span> Notifications <span data-notif-badge style="display:none; background:#ef4444; color:#fff; border-radius:10px; padding:1px 7px; font-size:0.7rem; font-weight:700;">0</span></a>
        <a href="{{ route('publications.index') }}" class="nav-item"><span>📋</span> Mes publications</a>
        <a href="{{ route('offres.choisir') }}" class="nav-item"><span>✍️</span> Proposer</a>
      </div>
      <div>
        <form action="{{ route('auth.logout') }}" method="POST">
          {{ csrfField() }}
          <button type="submit" class="nav-item" style="border:none; background:none; width:100%; color: #dc2626; cursor:pointer; font-size: 0.95rem;">
            <span>🚪</span> Déconnexion
          </button>
        </form>
      </div>
    </aside>

    <div class="main-wrapper">

      <div class="feed-column">

        @if(flashMessages.has('erreur'))
          <div class="erreur">{{ flashMessages.get('erreur') }}</div>
        @end

        <form id="publier" action="{{ route('web.actualite.store') }}" method="POST" enctype="multipart/form-data" class="post-creator">
          {{ csrfField() }}
          <div class="creator-top">
            <div class="avatar">
              @if(auth.user.photoProfil)
                <img src="{{ auth.user.photoProfil }}" alt="">
              @else
                {{ (auth.user.prenom || auth.user.nom).charAt(0).toUpperCase() }}
              @end
            </div>
            <textarea name="legend" class="creator-input" placeholder="Quoi de neuf à {{ auth.user.ville || 'votre ville' }} ?" rows="2" maxlength="1000"></textarea>
          </div>
          <div class="creator-actions">
            <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
              <label class="action-btn">
                🖼️ Photo / Vidéo
                <input type="file" name="media" id="champ-media" accept="image/*,video/mp4,video/webm,video/quicktime" style="display:none">
              </label>
              <span class="nom-fichier" id="nom-fichier"></span>
              <select name="categorie" class="select-cat">
                <option value="nouveaute">📰 Nouveauté</option>
                <option value="publicite">📣 Publicité</option>
              </select>
            </div>
            <button type="submit" class="btn-submit-post">Publier</button>
          </div>
        </form>

        <div class="feed-tabs">
          <a href="?categorie=tout" class="tab {{ filtre === 'tout' ? 'active' : '' }}">Tout</a>
          <a href="?categorie=nouveaute" class="tab {{ filtre === 'nouveaute' ? 'active' : '' }}">📰 Nouveautés</a>
          <a href="?categorie=publicite" class="tab {{ filtre === 'publicite' ? 'active' : '' }}">📣 Publicités</a>
        </div>

        @each(post in posts)
          <div class="post-card">
            <div class="post-header">
              <div class="post-user-info">
                <div class="avatar">
                  @if(post.photo)
                    <img src="{{ post.photo }}" alt="">
                  @else
                    {{ post.initiale }}
                  @end
                </div>
                <div>
                  <div>
                    <a class="post-author" href="/membre/{{ post.auteurId }}">{{ post.auteur }}</a>
                    @if(post.estEntreprise)
                      <span class="badge-ent">✔</span>
                    @end
                    @if(post.categorie === 'publicite')
                      <span class="badge-pub">📣 Publicité</span>
                    @end
                  </div>
                  <div class="post-date">{{ post.quand }}</div>
                </div>
              </div>
            </div>

            @if(post.legend)
              <div class="post-body">{{ post.legend }}</div>
            @end

            @if(post.mediaUrl)
              <div class="post-media-container">
                @if(post.type === 'video')
                  <video class="post-media" controls preload="metadata" src="{{ post.mediaUrl }}"></video>
                @else
                  <img class="post-media" src="{{ post.mediaUrl }}" alt="Publication">
                @end
              </div>
            @end

            @if(post.mien)
              <div class="post-actions-bar">
                <form action="/actualite/{{ post.id }}/supprimer" method="POST" onsubmit="return confirm('Supprimer cette publication ?')">
                  {{ csrfField() }}
                  <button type="submit" class="btn-suppr">🗑 Supprimer</button>
                </form>
              </div>
            @end
          </div>
        @else
          <p class="vide">Aucune publication pour l'instant dans votre ville. Soyez le premier !</p>
        @end

      </div>

      <div class="right-column">
        <div class="boost-card">
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <span style="font-weight: 700; font-size: 1rem; color: #065f46;">Boostez votre visibilité</span>
            <span style="font-size: 1.5rem;">🚀</span>
          </div>
          <p style="font-size: 0.85rem; color: #047857; margin: 8px 0 0 0; line-height: 1.4;">
            Attirez plus de clients avec nos offres premium.
          </p>
          <button class="btn-boost">Voir les offres</button>
        </div>
      </div>

    </div>
  </div>

  <script>
    // Affiche le nom du fichier choisi
    document.getElementById('champ-media').addEventListener('change', function () {
      document.getElementById('nom-fichier').textContent = this.files[0] ? '✅ ' + this.files[0].name : ''
    })
  </script>
  <script src="/notifications.js" defer></script>

@end