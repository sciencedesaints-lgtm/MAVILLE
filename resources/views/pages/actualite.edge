    .post-date { font-size: 0.75rem; color: #64748b; }
    .badge-pub { display: inline-block; margin-left: 8px; background: #fef3c7; color: #92400e; font-size: 0.7rem; font-weight: 700; padding: 2px 10px; border-radius: 12px; }
    .badge-ent { color: #16a34a; font-size: 0.8rem; }
    .post-body { padding: 0 20px 15px 20px; font-size: 0.95rem; line-height: 1.5; color: #334155; white-space: pre-line; }
