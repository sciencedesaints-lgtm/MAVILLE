  <section class="app-card active text-center" id="section-connexion">
    <div class="logo-card"><span>MA</span>VILLE</div>
    <h2>Connexion</h2>
    <p class="subtitle">Ravi de vous revoir ! Entrez vos identifiants pour vous connecter.</p>

    <form action="{{ route('web.session.store') }}" method="POST" id="form-connexion">
      {{ csrfField() }}
      
      <div class="form-group text-left">
        <label for="login">Identifiant (Email ou Téléphone)</label>
        <input type="text" name="login" id="login" placeholder="Email ou Téléphone" required />
      </div>

      <div class="form-group text-left">
        <label for="login-password">Mot de passe</label>
        <div class="password-group">
          <input type="password" name="password" id="login-password" placeholder="Mot de passe" required />
          <button type="button" id="toggle-password-login" class="btn-toggle">👁️</button>
        </div>
      </div>

      <div class="forgot-password-box">
        <a href="#" class="btn-link">Mot de passe oublié ?</a>
      </div>

      <div class="buttons-container">
        <button type="submit" class="btn btn-gradient">Se connecter</button>
      </div>
    </form>
  </section>

