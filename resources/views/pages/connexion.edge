<div class="connexion-container">
  <div class="connexion-card">
    
    <div class="connexion-header">
      <a href="#" class="connexion-logo"><span>MA</span><b>VILLE</b></a>
      <h1 class="connexion-title">Connexion</h1>
      <p class="connexion-subtitle">Ravi de vous revoir ! Entrez vos identifiants pour vous connecter.</p>
    </div>

    <form action="{{ route('web.session.store') }}" method="POST" id="form-connexion" class="form-grid">
      {{ csrfField() }}
      
      <div class="form-group">
        <label for="login" class="form-label">Identifiant (Email ou Téléphone)</label>
        <div class="input-wrapper">
          <span class="input-icon">✉️</span>
          <input type="text" name="login" id="login" class="form-input" placeholder="Email ou Téléphone" required />
        </div>
      </div>

      <div class="form-group">
        <label for="login-password" class="form-label">Mot de passe</label>
        <div class="input-wrapper">
          <span class="input-icon">🔒</span>
          <input type="password" name="password" id="login-password" class="form-input" placeholder="Mot de passe" required />
          <button type="button" id="toggle-password-login" class="toggle-password">👁️</button>
        </div>
      </div>

      <div class="form-options">
        <label class="remember-me">
          <input type="checkbox" name="remember" /> Se souvenir de moi
        </label>
        <a href="#" class="forgot-password">Mot de passe oublié ?</a>
      </div>

      <button type="submit" class="btn-submit">
        Se connecter <span>→</span>
      </button>
    </form>

    <div class="connexion-footer">
      Vous n'avez pas de compte ? <a href="#">Inscrivez-vous</a>
    </div>

  </div>
</div>

