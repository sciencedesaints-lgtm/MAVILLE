@component('layouts/main', { title: nomComplet + ' - MAVILLE' })

  <style>
    .mb-page { min-height: 100vh; background: #0f172a; display: flex; justify-content: center; padding: 32px 16px; box-sizing: border-box; font-family: system-ui, sans-serif; }
    .mb-wrap { width: 100%; max-width: 760px; }
    .mb-entete { background: #1e293b; border: 1px solid #334155; border-radius: 20px; padding: 28px; display: flex; align-items: center; gap: 22px; margin-bottom: 24px; }
    .mb-avatar { width: 96px; height: 96px; border-radius: 50%; background: linear-gradient(135deg, #10b981, #0369a1); color: #fff; font-size: 2rem; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; }
    .mb-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .mb-nom { color: #f8fafc; font-size: 1.5rem; margin: 0 0 4px; }
    .mb-meta { color: #94a3b8; font-size: 0.92rem; margin: 2px 0; }
    .mb-tel { display: inline-block; margin-top: 12px; padding: 9px 18px; border-radius: 20px; background: #059669; color: #fff; text-decoration: none; font-weight: 600; font-size: 0.9rem; }
    .mb-titre { color: #38bdf8; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; margin: 26px 0 12px; }
    .mb-carte { background: #1e293b; border: 1px solid #334155; border-radius: 14px; padding: 16px 18px; margin-bottom: 10px; }
    .mb-carte h3 { color: #f8fafc; margin: 0 0 4px; font-size: 1rem; }
    .mb-prix { color: #34d399; font-weight: 700; margin-top: 6px; }
    .mb-vide { color: #64748b; font-style: italic; }
    .mb-retour { display: block; text-align: center; color: #94a3b8; margin-top: 24px; text-decoration: none; font-size: 0.9rem; }
    .mb-medias { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
.mb-media { width: 150px; height: 110px; object-fit: cover; border-radius: 10px; background: #0f172a; }
.mb-carte.off { opacity: 0.5; filter: grayscale(1); }
.mb-off { display: inline-block; margin-left: 8px; padding: 2px 10px; border-radius: 12px; background: #92400e; color: #fff; font-size: 0.7rem; font-weight: 700; vertical-align: middle; }
  </style>

  <div class="mb-page">
    <div class="mb-wrap">

      <div class="mb-entete">
        <div class="mb-avatar">
          @if(membre.photo_profil)
            <img src="{{ membre.photo_profil }}" alt="{{ nomComplet }}">
          @else
            {{ initiales }}
          @end
        </div>
        <div>
          <h1 class="mb-nom">{{ nomComplet }}</h1>
                    @if(membre.profession)
            <p class="mb-meta">🎓 {{ membre.profession }}</p>
          @end
          @if(membre.qualification)
            <p class="mb-meta">{{ membre.qualification }}</p>
          @end
          <p class="mb-meta">📍 {{ membre.ville }}{{ membre.pays ? ', ' + membre.pays : '' }}</p>
          @if(membre.type_compte === 'entreprise_agence')
            <p class="mb-meta">🏢 Entreprise ou agence</p>
          @elseif(membre.type_compte === 'administration_publique')
            <p class="mb-meta">🏛️ Administration publique</p>
          @end
          @if(membre.telephone)
            <a class="mb-tel" href="tel:{{ membre.telephone }}">📞 {{ membre.telephone }}</a>
          @end
        </div>
      </div>

          @if(services.length)
        <h2 class="mb-titre">🔧 Services proposés</h2>
        @each(s in services)
          <h3>
  {{ s.nom }}
  @if(!s.disponible)
    <span class="mb-off">⛔ Indisponible</span>
  @end
</h3>
            @if(s.categorie_nom)
              <p class="mb-meta">{{ s.categorie_nom }}</p>
            @end
            @if(s.description)
              <p class="mb-meta">{{ s.description }}</p>
            @end
            @if(s.prix_min)
              <p class="mb-prix">dès {{ Number(s.prix_min) }} {{ s.devise }}</p>
            @end
            @if(s.medias.length)
              <div class="mb-medias">
                @each(m in s.medias)
                  @if(m.type === 'video')
                    <video class="mb-media" src="{{ m.url }}" controls preload="metadata"></video>
                  @else
                    <img class="mb-media" src="{{ m.url }}" alt="">
                  @end
                @end
              </div>
            @end
          </div>
        @end
      @end

      @if(commerces.length)
        <h2 class="mb-titre">🏪 Commerces</h2>
        @each(c in commerces)
          <div class="mb-carte">
            <h3>{{ c.nom }}</h3>
            @if(c.categorie_nom)
              <p class="mb-meta">{{ c.categorie_nom }}</p>
            @end
            <p class="mb-meta">📍 {{ c.adresse }}</p>
            @if(c.horaires)
              <p class="mb-meta">🕒 {{ c.horaires }}</p>
            @end
            @if(c.medias.length)
              <div class="mb-medias">
                @each(m in c.medias)
                  @if(m.type === 'video')
                    <video class="mb-media" src="{{ m.url }}" controls preload="metadata"></video>
                  @else
                    <img class="mb-media" src="{{ m.url }}" alt="">
                  @end
                @end
              </div>
            @end
          </div>
        @end
      @end

      @if(annonces.length)
        <h2 class="mb-titre">🛍️ Annonces</h2>
        @each(a in annonces)
          <div class="mb-carte">
            <h3>{{ a.titre }} · {{ a.type_offre === 'location' ? 'À louer' : 'À vendre' }}</h3>
            @if(a.categorie_nom)
              <p class="mb-meta">{{ a.categorie_nom }}</p>
            @end
            @if(a.description)
              <p class="mb-meta">{{ a.description }}</p>
            @end
            @if(a.prix)
              <p class="mb-prix">{{ Number(a.prix) }} {{ a.devise }}{{ a.type_offre === 'location' ? ' / ' + a.periodicite : '' }}</p>
            @end
            @if(a.medias.length)
              <div class="mb-medias">
                @each(m in a.medias)
                  @if(m.type === 'video')
                    <video class="mb-media" src="{{ m.url }}" controls preload="metadata"></video>
                  @else
                    <img class="mb-media" src="{{ m.url }}" alt="">
                  @end
                @end
              </div>
            @end
          </div>
        @end
      @end

      @if(!services.length && !commerces.length && !annonces.length)
        <p class="mb-vide">Cette personne n'a encore rien publié.</p>
      @end

      <a class="mb-retour" href="javascript:history.back()">← Retour aux résultats</a>
    </div>
  </div>

@end