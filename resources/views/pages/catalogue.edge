@component('layouts/main', { title: commerce.nom + ' - MAVILLE' })

  <style>
    .ct-page { min-height: 100vh; background: #0f172a; display: flex; justify-content: center; padding: 32px 16px; box-sizing: border-box; font-family: system-ui, sans-serif; }
    .ct-wrap { width: 100%; max-width: 760px; }
    .ct-entete { background: #1e293b; border: 1px solid #334155; border-radius: 16px; padding: 22px; margin-bottom: 22px; }
    .ct-entete h1 { color: #f8fafc; font-size: 1.5rem; margin: 0 0 8px; }
    .ct-meta { color: #94a3b8; font-size: 0.9rem; margin: 3px 0; }
    .ct-tel { display: inline-block; margin: 12px 8px 0 0; padding: 8px 16px; border-radius: 20px; background: #059669; color: #fff; text-decoration: none; font-size: 0.88rem; font-weight: 600; }
    .ct-article { background: #1e293b; border: 1px solid #334155; border-radius: 14px; padding: 16px 18px; margin-bottom: 12px; }
    .ct-article h3 { color: #f8fafc; margin: 0 0 4px; font-size: 1.05rem; }
    .ct-prix { color: #34d399; font-weight: 700; margin-top: 6px; }
    .ct-photos { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
    .ct-photos img { width: 130px; height: 100px; object-fit: cover; border-radius: 10px; }
    .ct-vide { color: #64748b; font-style: italic; text-align: center; padding: 30px 0; }
    .ct-retour { display: block; text-align: center; color: #94a3b8; margin-top: 22px; text-decoration: none; font-size: 0.9rem; }
  </style>

  <div class="ct-page">
    <div class="ct-wrap">

      <div class="ct-entete">
        <h1>🏪 {{ commerce.nom }}</h1>
        <p class="ct-meta">📍 {{ commerce.adresse }}</p>
        @if(commerce.horaires)
          <p class="ct-meta">🕒 {{ commerce.horaires }}</p>
        @end
        @if(commerce.description)
          <p class="ct-meta">{{ commerce.description }}</p>
        @end
        @if(commerce.telephone)
          <a class="ct-tel" href="tel:{{ commerce.telephone }}">📞 {{ commerce.telephone }}</a>
        @end
        @if(commerce.whatsapp)
          <a class="ct-tel" href="https://wa.me/{{ commerce.whatsapp.replace(/[^0-9]/g, '') }}">💬 WhatsApp</a>
        @end
      </div>

      @each(a in articles)
        <div class="ct-article">
          <h3>{{ a.nom }}</h3>
          @if(a.categorie)
            <p class="ct-meta">{{ a.categorie }}</p>
          @end
          @if(a.description)
            <p class="ct-meta">{{ a.description }}</p>
          @end
          <p class="ct-prix">{{ a.prix }}</p>
          @if(a.photos.length)
            <div class="ct-photos">
              @each(url in a.photos)
                <img src="{{ url }}" alt="{{ a.nom }}">
              @end
            </div>
          @end
        </div>
      @else
        <p class="ct-vide">Ce commerce n'a pas encore publié d'articles.</p>
      @end

      <a class="ct-retour" href="javascript:history.back()">← Retour aux résultats</a>
    </div>
  </div>

@end