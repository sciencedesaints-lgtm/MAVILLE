@component('layouts/main', { title: 'Modifier mon profil - MAVILLE' })

  <style>
    .pm-page { min-height: 100vh; background: #0f172a; display: flex; justify-content: center; padding: 40px 16px; box-sizing: border-box; font-family: system-ui, sans-serif; }
    .pm-card { width: 100%; max-width: 600px; background: #1e293b; border: 1px solid #334155; border-radius: 20px; padding: 32px; box-sizing: border-box; height: fit-content; }
    .pm-card h1 { color: #f8fafc; font-size: 1.5rem; margin: 0 0 6px; text-align: center; }
    .pm-card p.sub { color: #94a3b8; font-size: 0.9rem; text-align: center; margin: 0 0 24px; }
    .pm-card h2 { color: #38bdf8; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; margin: 24px 0 14px; border-bottom: 1px solid #334155; padding-bottom: 8px; }
    .pm-card label.champ { display: block; color: #e2e8f0; font-size: 0.9rem; font-weight: 600; margin-bottom: 6px; }
    .pm-card input[type=text], .pm-card textarea { width: 100%; padding: 12px; border-radius: 10px; border: 1px solid #475569; background: #0f172a; color: #f8fafc; font-size: 0.95rem; box-sizing: border-box; margin-bottom: 16px; font-family: inherit; }
    .pm-card input[type=file] { width: 100%; color: #e2e8f0; margin-bottom: 16px; }
    .pm-card .ligne { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .pm-card button { width: 100%; padding: 14px; border: none; border-radius: 12px; background: linear-gradient(135deg, #10b981, #059669); color: #fff; font-size: 1rem; font-weight: 700; cursor: pointer; margin-top: 8px; }
    .pm-card a.retour { display: block; text-align: center; color: #94a3b8; margin-top: 14px; font-size: 0.9rem; text-decoration: none; }
    .pm-erreur { background: #7f1d1d; color: #fecaca; padding: 10px 14px; border-radius: 10px; margin-bottom: 16px; font-size: 0.9rem; }
    .pm-aide { color: #64748b; font-size: 0.8rem; margin: -10px 0 16px; }
    .pm-banniere { height: 110px; border-radius: 12px; background: #0f172a center/cover no-repeat; margin-bottom: 10px; border: 1px solid #334155; }
    .pm-avatar { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; margin-bottom: 10px; border: 1px solid #334155; }
    @media (max-width: 520px) { .pm-card .ligne { grid-template-columns: 1fr; } }
  </style>

  <div class="pm-page">
    <div class="pm-card">
      <h1>Modifier mon profil</h1>
      <p class="sub">Ces informations sont visibles sur votre profil public.</p>

      @if(flashMessages.has('erreur'))
        <div class="pm-erreur">{{ flashMessages.get('erreur') }}</div>
      @end

      <form action="{{ route('profil.modifier.enregistrer') }}" method="POST" enctype="multipart/form-data">
        {{ csrfField() }}

        <h2>Photos</h2>

        <label class="champ" for="banniere">Photo de bannière (jpg, png, webp, 8 Mo maximum)</label>
        @if(moi.photo_banniere)
          <div class="pm-banniere" style="background-image: url('{{ moi.photo_banniere }}');"></div>
        @end
        <input type="file" id="banniere" name="banniere" accept="image/*">

        <label class="champ" for="photo">Photo de profil (jpg, png, webp, 5 Mo maximum)</label>
        @if(moi.photo_profil)
          <img class="pm-avatar" src="{{ moi.photo_profil }}" alt="Photo actuelle">
        @end
        <input type="file" id="photo" name="photo" accept="image/*">

        <h2>Identité</h2>

        <div class="ligne">
          <div>
            <label class="champ" for="nom">Nom</label>
            <input type="text" id="nom" name="nom" value="{{ moi.nom || '' }}" required minlength="2">
          </div>
          @if(moi.type_compte === 'personnel')
            <div>
              <label class="champ" for="prenom">Prénom</label>
              <input type="text" id="prenom" name="prenom" value="{{ moi.prenom || '' }}">
            </div>
          @end
        </div>

        <label class="champ" for="pseudo">Pseudo (facultatif)</label>
        <input type="text" id="pseudo" name="pseudo" value="{{ moi.pseudo || '' }}">

        <h2>Profession et qualification</h2>

        <label class="champ" for="profession">Profession</label>
        <input type="text" id="profession" name="profession" value="{{ moi.profession || '' }}" placeholder="Ex : Plombier, Infirmière, Développeur web, Avocat">
        <p class="pm-aide">Les personnes qui cherchent cette profession vous trouveront directement.</p>

        <label class="champ" for="qualification">Qualification</label>
        <textarea id="qualification" name="qualification" rows="3" placeholder="Ex : Licence en informatique, 8 ans d'expérience, certifié en soudure">{{ moi.qualification || '' }}</textarea>

        <h2>Où me trouver</h2>

        <div class="ligne">
          <div>
            <label class="champ" for="commune">Commune</label>
            <input type="text" id="commune" name="commune" value="{{ moi.commune || '' }}">
          </div>
          <div>
            <label class="champ" for="quartier">Quartier</label>
            <input type="text" id="quartier" name="quartier" value="{{ moi.quartier || '' }}">
          </div>
        </div>

        <button type="submit">Enregistrer</button>
      </form>

      <a class="retour" href="{{ route('profil.personnel') }}">← Retour au profil</a>
    </div>
  </div>

@end