              @end
              @if(r.categorie)
                <p class="meta">{{ r.categorie }}</p>
              @end
              @if(r.lieu)
                <p class="meta">📍 {{ r.lieu }}</p>
              @end
              @if(r.distanceTexte)
                <p class="distance">🧭 {{ r.distanceTexte }}</p>
              @end
              @if(r.prix)
                <p class="prix">{{ r.prix }}</p>
              @end

              @if(r.description)
                <p class="desc">{{ r.description }}</p>
              @end
              @if(r.details.length)
                <div class="puces">
                  @each(dt in r.details)
                    <span class="puce">{{ dt }}</span>
                  @end
                </div>
              @end

                            @if(r.medias && r.medias.length)
                <div class="vignettes">
                  @each(m in r.medias)
                    @if(m.type === 'video')
                      <video src="{{ m.url }}" controls preload="metadata"></video>
                    @else
                      <img src="{{ m.url }}" alt="Photo de l'offre">
                    @end
                  @end
                </div>
              @end

              @if(r.articles && r.articles.length)
                <div class="articles">
                  @each(a in r.articles)
                    <div class="article">
                      @if(a.photo)
                        <img src="{{ a.photo }}" alt="{{ a.nom }}">
                      @end
                      <div>
                        <p class="article-nom">{{ a.nom }}</p>
                        <p class="article-prix">{{ a.prix }}</p>
                        @if(a.description)
                          <p class="article-desc">{{ a.description }}</p>
                        @end
                      </div>
                    </div>
                  @end
                </div>
                @if(r.voirPlus)
                  <a class="voir-plus" href="{{ r.voirPlus }}">🛒 Voir plus d'articles ({{ r.nbArticles }})</a>
                @end
              @end

              @if(r.statut === 'disponible')
                <span class="etat disponible">✅ Disponible, confirmé par le vendeur</span>
              @elseif(r.statut === 'en_attente')
                <span class="etat">⏳ En attente de réponse du vendeur</span>
              @elseif(r.statut === 'indisponible')
                <span class="etat indisponible">❌ Indisponible</span>
              @end
            </div>
            <span class="badge {{ r.genre }}">{{ r.genre }}</span>
          </div>

          @if(r.telephone)
            <a class="tel" href="tel:{{ r.telephone }}">📞 {{ r.telephone }}</a>
          @end

          <form class="supp" action="/resultats/masquer" method="POST">
            {{ csrfField() }}
            <input type="hidden" name="genre" value="{{ r.genre }}">
            <input type="hidden" name="offre_id" value="{{ r.id }}">
            <input type="hidden" name="titre" value="{{ r.titre }}">
            <input type="hidden" name="categorie" value="{{ r.categorie || '' }}">
            <button type="submit" class="btn-supp">🗑 Retirer de mes résultats</button>
          </form>
        </div>
      @else
        @if(villeConnue)
          <p class="vide">Aucun résultat pour l'instant.</p>
        @end
      @end

      <a class="retour" href="{{ route('web.accueil') }}">← Retour à l'accueil</a>
    </div>
  </div>

    <div class="visionneur" id="visionneur"><img id="visionneur-img" src="" alt=""></div>

  <script>
    // Ajoute la position de l'utilisateur à l'adresse (une seule tentative par recherche)
    (function () {
      var p = new URLSearchParams(location.search)
      if (p.get('lat') || !navigator.geolocation) return
      var cle = 'geo_essai_' + location.search
      try {
        if (sessionStorage.getItem(cle)) return
        sessionStorage.setItem(cle, '1')
      } catch (e) {}
      navigator.geolocation.getCurrentPosition(
        function (pos) {
          if (pos.coords.accuracy > 1000) return
          p.set('lat', pos.coords.latitude.toFixed(5))
          p.set('lng', pos.coords.longitude.toFixed(5))
          location.replace(location.pathname + '?' + p.toString())
        },
        function () {},
        { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 }
      )
    })()
        var vis = document.getElementById('visionneur')
    var visImg = document.getElementById('visionneur-img')
    document.querySelectorAll('.vignettes img').forEach(function (img) {
      img.addEventListener('click', function () { visImg.src = img.src; vis.classList.add('ouvert') })
    })
    vis.addEventListener('click', function () { vis.classList.remove('ouvert'); visImg.src = '' })
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') vis.click() })
  </script>

@end