        <a href="?q={{ q }}&type=administration&portee={{ portee }}&r={{ rechercheId }}&lat={{ lat }}&lng={{ lng }}" class="{{ type === 'administration' ? 'actif' : '' }}">🏛️ Administrations</a>
        <a href="?q={{ q }}&type=professionnel&portee={{ portee }}&r={{ rechercheId }}&lat={{ lat }}&lng={{ lng }}" class="{{ type === 'professionnel' ? 'actif' : '' }}">🎓 Professionnels</a>
