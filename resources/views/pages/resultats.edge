      @if(villeConnue && !lieuCite && !positionConnue)
        <div class="res-alerte">📍 Position précise indisponible. Activez la localisation (GPS) pour voir d'abord les offres proches de vous. Voici les résultats de toute la ville.</div>
      @end

      @if(messageProche)
        <div class="res-alerte">{{ messageProche }} Voici les résultats de toute la ville.</div>
      @end

      @each(r in resultats)
