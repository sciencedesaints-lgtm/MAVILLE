          <h3 style="margin: 15px 0 10px 0; color: #1e293b;">Glissez ou placez votre image ici</h3>
          <p style="color: #64748b; margin-bottom: 20px;">Recherchez un produit ou un lieu à partir d'une photo</p>
          <input type="file" accept="image/*" style="margin: 0 auto; display: block;">
        </div>
      </div>

    </div>
  </div>

  {{-- Gestion interactive de l'ouverture de la recherche et des choix --}}
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const openBtn = document.getElementById('open-search-overlay');
      const overlay = document.getElementById('search-overlay-page');
      const closeBtn = document.getElementById('close-search-overlay');
      
      const choicesContainer = document.getElementById('search-choices-container');
      const textView = document.getElementById('text-search-exclusive-view');
      const imageView = document.getElementById('image-search-exclusive-view');
      
      const btnChoiceText = document.getElementById('btn-choice-text');
      const btnChoiceImage = document.getElementById('btn-choice-image');
      const btnChoiceVoice = document.getElementById('btn-choice-voice');
      
      const backToChoices = document.getElementById('back-to-choices');
      const backToChoicesImg = document.getElementById('back-to-choices-img');

      const searchInput = document.getElementById('live-search-input');
      const suggestionsBox = document.getElementById('suggestions-box');
      const submitSearch = document.getElementById('btn-submit-search');

      // Ouvrir la page entière de recherche
      openBtn.addEventListener('click', () => {
        overlay.style.display = 'block';
        choicesContainer.style.display = 'flex';
        textView.style.display = 'none';
        imageView.style.display = 'none';
      });

      // Fermer la page de recherche
      closeBtn.addEventListener('click', () => {
        overlay.style.display = 'none';
      });

      // Cliquer sur "Taper votre demande"
      btnChoiceText.addEventListener('click', () => {
        choicesContainer.style.display = 'none';
        textView.style.display = 'block';
        searchInput.focus();
      });

      // Cliquer sur "Placez votre image"
      btnChoiceImage.addEventListener('click', () => {
        choicesContainer.style.display = 'none';
        imageView.style.display = 'block';
      });

      // Cliquer sur "Recherche vocale"
      btnChoiceVoice.addEventListener('click', () => {
        alert('Écoute vocale activée... Parlez maintenant.');
      });

      // Retour aux options depuis le texte
      backToChoices.addEventListener('click', () => {
        textView.style.display = 'none';
        choicesContainer.style.display = 'flex';
      });

      // Retour aux options depuis l'image
      backToChoicesImg.addEventListener('click', () => {
        imageView.style.display = 'none';
        choicesContainer.style.display = 'flex';
      });

      // Gestion des propositions en direct (ex: Ma...)
      searchInput.addEventListener('input', (e) => {
        const val = e.target.value.trim();
        if (val.toLowerCase().startsWith('ma') && val.length > 0) {
          suggestionsBox.style.display = 'block';
        } else {
          suggestionsBox.style.display = 'none';
        }
      });

      // Cliquer sur une proposition
      document.querySelectorAll('.suggestion-item').forEach(item => {
        item.addEventListener('click', function() {
          searchInput.value = this.getAttribute('data-value');
          suggestionsBox.style.display = 'none';
        });
      });

      // Lancer la recherche finale
      submitSearch.addEventListener('click', () => {
        if(searchInput.value.trim() !== '') {
          alert('Recherche lancée pour : ' + searchInput.value);
          overlay.style.display = 'none';
        } else {
          alert('Veuillez saisir ou sélectionner une recherche.');
        }
      });
    });
  </script>

  {{-- Chargement correct du script via l'assistant Vite d'AdonisJS v6 --}}
  @slot('page_js')
    @vite(['resources/js/accueil.js'])
  @end

@end