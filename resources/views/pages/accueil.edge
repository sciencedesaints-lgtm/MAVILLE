  <div id="search-overlay-page" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: #f8fafc; z-index: 9999; padding: 40px; box-sizing: border-box; overflow-y: auto;">
    
    <div style="max-width: 800px; margin: 0 auto; position: relative;">
      
      <!-- Bouton pour fermer la page de recherche -->
      <button id="close-search-overlay" style="position: absolute; right: 0; top: 0; background: #e2e8f0; border: none; font-size: 1.2rem; width: 40px; height: 40px; border-radius: 50%; cursor: pointer; font-weight: bold;">✕</button>

      <h2 style="font-size: 2rem; color: #0f172a; margin-bottom: 30px; text-align: center;">Que recherchez-vous aujourd'hui ?</h2>

      <!-- ÉTAPE 1 : Les 3 Boutons Principaux -->
      <div id="search-choices-container" style="display: flex; flex-direction: column; gap: 20px; align-items: center; margin-top: 40px;">
        
        <!-- Bouton 1 : Taper votre demande -->
        <button id="btn-choice-text" style="width: 100%; max-width: 500px; padding: 22px 30px; background: #ffffff; border: 2px solid #cbd5e1; border-radius: 12px; font-size: 1.1rem; font-weight: 600; color: #1e293b; cursor: pointer; display: flex; align-items: center; gap: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); transition: all 0.2s;">
          <span style="font-size: 1.5rem;">⌨️</span> Taper votre demande / recherche
        </button>

        <!-- Bouton 2 : Placez votre image -->
        <button id="btn-choice-image" style="width: 100%; max-width: 500px; padding: 22px 30px; background: #ffffff; border: 2px solid #cbd5e1; border-radius: 12px; font-size: 1.1rem; font-weight: 600; color: #1e293b; cursor: pointer; display: flex; align-items: center; gap: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); transition: all 0.2s;">
          <span style="font-size: 1.5rem;">📷</span> Placez votre image
        </button>

        <!-- Bouton 3 : Recherche vocale (Très remarquable en bas) -->
        <button id="btn-choice-voice" style="width: 100%; max-width: 500px; padding: 25px 30px; background: linear-gradient(135deg, #10b981, #059669); border: none; border-radius: 16px; font-size: 1.25rem; font-weight: bold; color: #ffffff; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 15px; box-shadow: 0 10px 25px rgba(16, 185, 129, 0.4); margin-top: 20px; transition: transform 0.2s;">
          <span style="font-size: 1.8rem;">🎙️</span> Recherche vocale
        </button>
      </div>

      <!-- ÉTAPE 2 : Page exclusive de saisie de texte avec propositions -->
      <div id="text-search-exclusive-view" style="display: none; margin-top: 20px;">
        <button id="back-to-choices" style="background: none; border: none; color: #2563eb; font-weight: 600; cursor: pointer; margin-bottom: 15px; font-size: 0.95rem;">← Retour aux options</button>
        
        <div style="background: #ffffff; padding: 25px; border-radius: 16px; box-shadow: 0 10px 25px rgba(0,0,0,0.08); border: 1px solid #e2e8f0;">
          <label style="display: block; font-weight: 600; color: #334155; margin-bottom: 10px;">Entrez votre recherche textuelle :</label>
          
          <div style="position: relative;">
            <input type="text" id="live-search-input" placeholder="ex: Ma..." style="width: 100%; padding: 15px 20px; font-size: 1.1rem; border: 2px solid #cbd5e1; border-radius: 10px; outline: none; box-sizing: border-box;">
            
            <!-- Liste de propositions dynamique -->
            <div id="suggestions-box" style="display: none; position: absolute; top: 100%; left: 0; width: 100%; background: #ffffff; border: 1px solid #cbd5e1; border-top: none; border-radius: 0 0 10px 10px; box-shadow: 0 10px 15px rgba(0,0,0,0.05); z-index: 50;">
              <div class="suggestion-item" style="padding: 12px 20px; cursor: pointer; border-bottom: 1px solid #f1f5f9; color: #1e293b;" data-value="Maison à louer, à vendre ou à acheter">🏠 <strong>Ma</strong>ison à louer, à vendre ou à acheter</div>
              <div class="suggestion-item" style="padding: 12px 20px; cursor: pointer; border-bottom: 1px solid #f1f5f9; color: #1e293b;" data-value="Marché central de Lubumbashi">🛒 <strong>Ma</strong>rché central de Lubumbashi</div>
              <div class="suggestion-item" style="padding: 12px 20px; cursor: pointer; color: #1e293b;" data-value="Matériel informatique et bureautique">💻 <strong>Ma</strong>tériel informatique et bureautique</div>
            </div>
          </div>

          <!-- Bouton de validation final -->
          <button id="btn-submit-search" style="width: 100%; margin-top: 25px; padding: 16px; background: #0f172a; color: white; border: none; border-radius: 10px; font-size: 1.1rem; font-weight: bold; cursor: pointer; transition: background 0.2s;">
            Lancer votre recherche
          </button>
        </div>
      </div>

      <!-- ÉTAPE 3 : Vue exclusive Image -->
      <div id="image-search-exclusive-view" style="display: none; margin-top: 20px;">
        <button id="back-to-choices-img" style="background: none; border: none; color: #2563eb; font-weight: 600; cursor: pointer; margin-bottom: 15px; font-size: 0.95rem;">← Retour aux options</button>
        <div style="background: #ffffff; padding: 40px; border-radius: 16px; text-align: center; border: 2px dashed #cbd5e1;">
          <span style="font-size: 3rem;">📁</span>
          <h3 style="margin: 15px 0 10px 0; color: #1e293b;">Glissez ou placez votre image ici</h3>
          <p style="color: #64748b; margin-bottom: 20px;">Recherchez un produit ou un lieu à partir d'une photo</p>
          <input type="file" accept="image/*" style="margin: 0 auto; display: block;">
        </div>
      </div>

    </div>
  </div>

  {{-- Gestion interactive de l'ouverture de la recherche et des choix --}}
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const openBtn = document.getElementById('open-search-overlay');
      const overlay = document.getElementById('search-overlay-page');
      const closeBtn = document.getElementById('close-search-overlay');
      
      const choicesContainer = document.getElementById('search-choices-container');
      const textView = document.getElementById('text-search-exclusive-view');
      const imageView = document.getElementById('image-search-exclusive-view');
      
      const btnChoiceText = document.getElementById('btn-choice-text');
      const btnChoiceImage = document.getElementById('btn-choice-image');
      const btnChoiceVoice = document.getElementById('btn-choice-voice');
      
      const backToChoices = document.getElementById('back-to-choices');
      const backToChoicesImg = document.getElementById('back-to-choices-img');

      const searchInput = document.getElementById('live-search-input');
      const suggestionsBox = document.getElementById('suggestions-box');
      const submitSearch = document.getElementById('btn-submit-search');

      // Ouvrir la page entière de recherche
      openBtn.addEventListener('click', () => {
        overlay.style.display = 'block';
        choicesContainer.style.display = 'flex';
        textView.style.display = 'none';
        imageView.style.display = 'none';
      });

      // Fermer la page de recherche
      closeBtn.addEventListener('click', () => {
        overlay.style.display = 'none';
      });

      // Cliquer sur "Taper votre demande"
      btnChoiceText.addEventListener('click', () => {
        choicesContainer.style.display = 'none';
        textView.style.display = 'block';
        searchInput.focus();
      });

      // Cliquer sur "Placez votre image"
      btnChoiceImage.addEventListener('click', () => {
        choicesContainer.style.display = 'none';
        imageView.style.display = 'block';
      });

      // Cliquer sur "Recherche vocale"
      btnChoiceVoice.addEventListener('click', () => {
        alert('Écoute vocale activée... Parlez maintenant.');
      });

      // Retour aux options depuis le texte
      backToChoices.addEventListener('click', () => {
        textView.style.display = 'none';
        choicesContainer.style.display = 'flex';
      });

      // Retour aux options depuis l'image
      backToChoicesImg.addEventListener('click', () => {
        imageView.style.display = 'none';
        choicesContainer.style.display = 'flex';
      });

      // Gestion des propositions en direct (ex: Ma...)
      searchInput.addEventListener('input', (e) => {
        const val = e.target.value.trim();
        if (val.toLowerCase().startsWith('ma') && val.length > 0) {
          suggestionsBox.style.display = 'block';
        } else {
          suggestionsBox.style.display = 'none';
        }
      });

      // Cliquer sur une proposition
      document.querySelectorAll('.suggestion-item').forEach(item => {
        item.addEventListener('click', function() {
          searchInput.value = this.getAttribute('data-value');
          suggestionsBox.style.display = 'none';
        });
      });

      // Lancer la recherche finale
      submitSearch.addEventListener('click', () => {
        if(searchInput.value.trim() !== '') {
          alert('Recherche lancée pour : ' + searchInput.value);
          overlay.style.display = 'none';
        } else {
          alert('Veuillez saisir ou sélectionner une recherche.');
        }
      });
    });
  </script>

  {{-- Chargement correct du script via l'assistant Vite d'AdonisJS v6 --}}
  @slot('page_js')
    @vite(['resources/js/accueil.js'])
  @end

