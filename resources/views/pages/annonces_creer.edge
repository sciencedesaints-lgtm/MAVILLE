@component('layouts/main', { title: 'Vendre ou louer - MAVILLE' })

  <style>
    .ann-page { min-height: 100vh; background: #0f172a; display: flex; justify-content: center; padding: 40px 16px; box-sizing: border-box; font-family: system-ui, sans-serif; }
    .ann-card { width: 100%; max-width: 600px; background: #1e293b; border: 1px solid #334155; border-radius: 20px; padding: 32px; box-sizing: border-box; height: fit-content; }
    .ann-card h1 { color: #f8fafc; font-size: 1.5rem; margin: 0 0 6px; text-align: center; }
    .ann-card p.sub { color: #94a3b8; font-size: 0.9rem; text-align: center; margin: 0 0 24px; }
    .ann-card h2 { color: #38bdf8; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; margin: 26px 0 14px; border-bottom: 1px solid #334155; padding-bottom: 8px; }
    .ann-card label.champ { display: block; color: #e2e8f0; font-size: 0.9rem; font-weight: 600; margin-bottom: 6px; }
    .ann-card input[type=text], .ann-card input[type=number], .ann-card input[type=tel], .ann-card select, .ann-card textarea { width: 100%; padding: 12px; border-radius: 10px; border: 1px solid #475569; background: #0f172a; color: #f8fafc; font-size: 0.95rem; box-sizing: border-box; margin-bottom: 16px; font-family: inherit; }
    .ann-card input[type=file] { width: 100%; color: #e2e8f0; margin-bottom: 16px; }
    .ligne { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .ligne3 { display: grid; grid-template-columns: 1fr 110px; gap: 12px; }
    .bascule { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 18px; }
    .bascule label { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 14px; border: 2px solid #334155; border-radius: 12px; color: #e2e8f0; font-weight: 700; cursor: pointer; }
    .bascule input { accent-color: #10b981; }
    .bascule label:has(input:checked) { border-color: #10b981; background: #064e3b; }
    .option { display: flex; align-items: center; gap: 10px; color: #e2e8f0; font-size: 0.92rem; margin-bottom: 12px; cursor: pointer; }
    .option input { width: 18px; height: 18px; accent-color: #10b981; }
    .ann-card button { width: 100%; padding: 14px; border: none; border-radius: 12px; background: linear-gradient(135deg, #10b981, #059669); color: #fff; font-size: 1rem; font-weight: 700; cursor: pointer; margin-top: 12px; }
    .ann-card a.retour { display: block; text-align: center; color: #94a3b8; margin-top: 14px; font-size: 0.9rem; text-decoration: none; }
    .ann-erreur { background: #7f1d1d; color: #fecaca; padding: 10px 14px; border-radius: 10px; margin-bottom: 16px; font-size: 0.9rem; }
    #bloc-periodicite { display: none; }
    @media (max-width: 520px) { .ligne, .ligne3 { grid-template-columns: 1fr; } }
  </style>

  <div class="ann-page">
    <div class="ann-card">
      <h1>Vendre ou louer</h1>
      <p class="sub">Meubles, voiture, parcelle, maison... publiez votre annonce.</p>

      @if(flashMessages.has('erreur'))
        <div class="ann-erreur">{{ flashMessages.get('erreur') }}</div>
      @end

     <form action="{{ route('annonces.store') }}" method="POST" enctype="multipart/form-data">
        {{ csrfField() }}

        <div class="bascule">
          <label><input type="radio" name="type_offre" value="vente" checked> 💰 À vendre</label>
          <label><input type="radio" name="type_offre" value="location"> 🔑 À louer</label>
        </div>

        <h2>L'annonce</h2>

        <label class="champ" for="titre">Titre</label>
        <input type="text" id="titre" name="titre" placeholder="Ex : Toyota Rav4 2012, parcelle 20x30, salon 5 places..." required minlength="3" maxlength="255">

        <div class="ligne">
          <div>
            <label class="champ" for="categorie_id">Catégorie</label>
            <select id="categorie_id" name="categorie_id" required>
              <option value="" disabled selected>Choisissez</option>
              @each(categorie in categories)
                <option value="{{ categorie.id }}">{{ categorie.icone }} {{ categorie.nom }}</option>
              @end
            </select>
          </div>
          <div>
            <label class="champ" for="etat">État</label>
            <select id="etat" name="etat">
              <option value="">Non précisé</option>
              <option value="neuf">Neuf</option>
              <option value="bon_etat">Bon état</option>
              <option value="occasion">Occasion</option>
            </select>
          </div>
        </div>

        <label class="champ" for="description">Description</label>
        <textarea id="description" name="description" rows="4" placeholder="Marque, année, kilométrage, surface, nombre de pièces, conditions..."></textarea>

        <h2>Prix</h2>

        <div class="ligne3">
          <div>
            <label class="champ" for="prix">Prix</label>
            <input type="number" id="prix" name="prix" min="0" step="0.01" placeholder="Ex : 5000">
          </div>
          <div>
            <label class="champ" for="devise">Devise</label>
            <select id="devise" name="devise">
              <option value="USD" selected>USD</option>
              <option value="CDF">CDF</option>
              <option value="EUR">EUR</option>
            </select>
          </div>
        </div>

        <div id="bloc-periodicite">
          <label class="champ" for="periodicite">Location : prix par</label>
          <select id="periodicite" name="periodicite">
            <option value="">Choisissez</option>
            <option value="jour">Jour</option>
            <option value="semaine">Semaine</option>
            <option value="mois">Mois</option>
            <option value="an">An</option>
          </select>
        </div>

        <label class="option"><input type="checkbox" name="prix_negociable" value="1" checked> Prix négociable</label>

        <h2>Où se trouve le bien</h2>

        <div class="ligne">
          <div>
            <label class="champ" for="commune">Commune</label>
            <input type="text" id="commune" name="commune" placeholder="Ex : Kampemba">
          </div>
          <div>
            <label class="champ" for="quartier">Quartier</label>
            <input type="text" id="quartier" name="quartier" placeholder="Ex : Bel-Air">
          </div>
        </div>

        <div class="ligne">
          <div>
            <label class="champ" for="avenue">Avenue ou rue</label>
            <input type="text" id="avenue" name="avenue" placeholder="Ex : Kasai">
          </div>
          <div>
            <label class="champ" for="repere">Repère</label>
            <input type="text" id="repere" name="repere" placeholder="Ex : près de l'école">
          </div>
        </div>

        <h2>Contact</h2>

        <div class="ligne">
          <div>
            <label class="champ" for="telephone">Téléphone</label>
            <input type="tel" id="telephone" name="telephone" value="{{ auth.user.telephone || '' }}" placeholder="+243...">
          </div>
          <div>
            <label class="champ" for="whatsapp">WhatsApp</label>
            <input type="tel" id="whatsapp" name="whatsapp" placeholder="+243...">
          </div>
        </div>

                <h2>Photos et vidéos</h2>

        <label class="champ" for="medias">Jusqu'à 5 fichiers (photos ou vidéos, 30 Mo maximum chacun)</label>
        <input type="file" id="medias" name="medias" accept="image/*,video/mp4,video/webm,video/quicktime" multiple>

        <button type="submit">Publier mon annonce</button>
      </form>

      <a class="retour" href="{{ route('offres.choisir') }}">← Retour</a>
    </div>
  </div>

  <script>
    // Affiche le choix de durée seulement pour une location
    const radios = document.querySelectorAll('input[name="type_offre"]')
    const bloc = document.getElementById('bloc-periodicite')
    radios.forEach((r) => r.addEventListener('change', () => {
      bloc.style.display = document.querySelector('input[name="type_offre"]:checked').value === 'location' ? 'block' : 'none'
    }))
  </script>

@end