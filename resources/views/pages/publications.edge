@component('layouts/main', { title: 'Mes publications - MAVILLE' })

  <style>
    .pb-page { min-height: 100vh; background: #0f172a; display: flex; justify-content: center; padding: 32px 16px; box-sizing: border-box; font-family: system-ui, sans-serif; }
    .pb-wrap { width: 100%; max-width: 760px; }
    .pb-wrap h1 { color: #f8fafc; font-size: 1.5rem; margin: 0 0 6px; }
    .pb-sub { color: #94a3b8; font-size: 0.9rem; margin: 0 0 22px; }
    .pb-carte { background: #1e293b; border: 1px solid #334155; border-radius: 14px; padding: 16px 18px; margin-bottom: 12px; }
    .pb-carte.masquee { opacity: 0.55; filter: grayscale(1); }
    .pb-haut { display: flex; justify-content: space-between; gap: 10px; align-items: flex-start; }
    .pb-titre { color: #f8fafc; margin: 0 0 4px; font-size: 1.05rem; }
    .pb-meta { color: #94a3b8; font-size: 0.85rem; margin: 2px 0; }
    .pb-badge { font-size: 0.7rem; padding: 3px 10px; border-radius: 12px; font-weight: 700; background: #334155; color: #e2e8f0; white-space: nowrap; }
    .pb-badge.off { background: #92400e; }
    .pb-actions { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
    .pb-actions form { margin: 0; }
    .pb-btn { padding: 8px 16px; border-radius: 20px; border: 1px solid #475569; background: #0f172a; color: #e2e8f0; font-size: 0.85rem; font-weight: 600; cursor: pointer; }
    .pb-btn.danger { border-color: #991b1b; color: #fca5a5; }
    .pb-vide { color: #64748b; font-style: italic; text-align: center; padding: 40px 0; }
    .pb-retour { display: block; text-align: center; color: #94a3b8; margin-top: 22px; text-decoration: none; font-size: 0.9rem; }
    .pb-nouveau { display: inline-block; margin-bottom: 18px; padding: 10px 18px; border-radius: 20px; background: #059669; color: #fff; text-decoration: none; font-weight: 600; font-size: 0.9rem; }
  </style>

  <div class="pb-page">
    <div class="pb-wrap">
      <h1>Mes publications</h1>
      <p class="pb-sub">Marquez vos offres indisponibles, remettez-les en ligne ou supprimez-les.</p>

      <a class="pb-nouveau" href="{{ route('offres.choisir') }}">+ Nouvelle publication</a>

      @each(p in publications)
        <div class="pb-carte {{ p.en_ligne ? '' : 'masquee' }}">
          <div class="pb-haut">
            <div>
              <h3 class="pb-titre">{{ p.titre }}</h3>
              @if(p.categorie)
                <p class="pb-meta">{{ p.categorie }}</p>
              @end
            </div>
            <div>
              <span class="pb-badge">{{ p.etiquette }}</span>
              @if(!p.en_ligne)
                <span class="pb-badge off">⛔ Indisponible</span>
              @end
            </div>
          </div>

          <div class="pb-actions">
            <form action="/publications/{{ p.genre }}/{{ p.id }}/basculer" method="POST">
              {{ csrfField() }}
              <button type="submit" class="pb-btn">{{ p.en_ligne ? 'Marquer indisponible' : 'Remettre en ligne' }}</button>
            </form>
            <form action="/publications/{{ p.genre }}/{{ p.id }}/supprimer" method="POST" onsubmit="return confirm('Supprimer définitivement cette publication ?')">
              {{ csrfField() }}
              <button type="submit" class="pb-btn danger">Supprimer</button>
            </form>
          </div>
        </div>
      @else
        <p class="pb-vide">Vous n'avez encore rien publié.</p>
      @end

      <a class="pb-retour" href="{{ route('profil.personnel') }}">← Retour au profil</a>
    </div>
  </div>

@end