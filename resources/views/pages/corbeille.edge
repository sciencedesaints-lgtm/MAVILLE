@component('layouts/main', { title: 'Corbeille - MAVILLE' })

  <style>
    .cb-page { min-height: 100vh; background: #0f172a; display: flex; justify-content: center; padding: 32px 16px; box-sizing: border-box; font-family: system-ui, sans-serif; }
    .cb-wrap { width: 100%; max-width: 760px; }
    .cb-wrap h1 { color: #f8fafc; font-size: 1.5rem; margin: 0 0 6px; }
    .cb-sub { color: #94a3b8; font-size: 0.9rem; margin: 0 0 22px; }
    .cb-carte { background: #1e293b; border: 1px solid #334155; border-radius: 14px; padding: 14px 18px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; gap: 10px; }
    .cb-titre { color: #f8fafc; margin: 0 0 4px; font-size: 1rem; }
    .cb-meta { color: #94a3b8; font-size: 0.82rem; margin: 0; }
    .cb-btn { padding: 8px 16px; border-radius: 20px; border: none; background: #059669; color: #fff; font-weight: 600; font-size: 0.85rem; cursor: pointer; }
    .cb-vide { color: #64748b; font-style: italic; text-align: center; padding: 40px 0; }
    .cb-retour { display: block; text-align: center; color: #94a3b8; margin-top: 22px; text-decoration: none; font-size: 0.9rem; }
  </style>

  <div class="cb-page">
    <div class="cb-wrap">
      <h1>🗑 Corbeille</h1>
      <p class="cb-sub">Résultats retirés de vos recherches. Restaurez-les quand vous voulez.</p>

      @each(e in elements)
        <div class="cb-carte">
          <div>
            <h3 class="cb-titre">{{ e.titre }}</h3>
            <p class="cb-meta">{{ e.genre }}{{ e.categorie ? ' · ' + e.categorie : '' }}</p>
          </div>
          <form action="/corbeille/{{ e.id }}/restaurer" method="POST">
            {{ csrfField() }}
            <button type="submit" class="cb-btn">Restaurer</button>
          </form>
        </div>
      @else
        <p class="cb-vide">La corbeille est vide.</p>
      @end

      <a class="cb-retour" href="javascript:history.back()">← Retour aux résultats</a>
    </div>
  </div>

@end