@component('layouts/main', { title: 'Proposer mes services - MAVILLE' })

  <style>
    .offre-page { min-height: 100vh; background: #0f172a; display: flex; justify-content: center; padding: 40px 16px; box-sizing: border-box; font-family: system-ui, sans-serif; }
    .offre-card { width: 100%; max-width: 640px; background: #1e293b; border: 1px solid #334155; border-radius: 20px; padding: 32px; box-sizing: border-box; height: fit-content; }
    .offre-card h1 { color: #f8fafc; font-size: 1.5rem; margin: 0 0 6px; text-align: center; }
    .offre-card p.sub { color: #94a3b8; font-size: 0.9rem; text-align: center; margin: 0 0 24px; }
    .offre-card h2 { color: #38bdf8; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; margin: 26px 0 14px; border-bottom: 1px solid #334155; padding-bottom: 8px; }
    .offre-card label.champ { display: block; color: #e2e8f0; font-size: 0.9rem; font-weight: 600; margin-bottom: 6px; }
    .offre-card input[type=text], .offre-card input[type=number], .offre-card input[type=tel], .offre-card input[type=email], .offre-card input[type=url], .offre-card select, .offre-card textarea { width: 100%; padding: 12px; border-radius: 10px; border: 1px solid #475569; background: #0f172a; color: #f8fafc; font-size: 0.95rem; box-sizing: border-box; margin-bottom: 16px; font-family: inherit; }
    .ligne { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .ligne3 { display: grid; grid-template-columns: 1fr 1fr 110px; gap: 12px; }
    .option { display: flex; align-items: center; gap: 10px; color: #e2e8f0; font-size: 0.92rem; margin-bottom: 12px; cursor: pointer; }
    .option input { width: 18px; height: 18px; accent-color: #10b981; }
    .offre-card button { width: 100%; padding: 14px; border: none; border-radius: 12px; background: linear-gradient(135deg, #10b981, #059669); color: #fff; font-size: 1rem; font-weight: 700; cursor: pointer; margin-top: 12px; }
    .offre-card a.retour { display: block; text-align: center; color: #94a3b8; margin-top: 14px; font-size: 0.9rem; text-decoration: none; }
    .offre-erreur { background: #7f1d1d; color: #fecaca; padding: 10px 14px; border-radius: 10px; margin-bottom: 16px; font-size: 0.9rem; }
    @media (max-width: 520px) { .ligne, .ligne3 { grid-template-columns: 1fr; } }
  </style>

  <div class="offre-page">
    <div class="offre-card">
      <h1>Proposer mes services</h1>
      <p class="sub">Les habitants qui cherchent ce que vous proposez seront notifiés.</p>

      @if(flashMessages.has('erreur'))
        <div class="offre-erreur">{{ flashMessages.get('erreur') }}</div>
      @end

      <form action="{{ route('offres.store') }}" method="POST">
        {{ csrfField() }}

        <h2>Votre offre</h2>

        <label class="champ" for="nom">Ce que vous proposez</label>
        <input type="text" id="nom" name="nom" placeholder="Ex : Chiots Cane Corso, Plomberie à domicile..." required minlength="3" maxlength="255">

        <label class="champ" for="categorie_id">Catégorie</label>
        <select id="categorie_id" name="categorie_id" required>
          <option value="" disabled selected>Choisissez une catégorie</option>
          @each(categorie in categories)
            <option value="{{ categorie.id }}">{{ categorie.icone }} {{ categorie.nom }}</option>
          @end
        </select>

        <label class="champ" for="description">Description</label>
        <textarea id="description" name="description" rows="4" placeholder="Détails, état, expérience, conditions..."></textarea>

        <h2>Prix</h2>

        <div class="ligne3">
          <div>
            <label class="champ" for="prix_min">Prix minimum</label>
            <input type="number" id="prix_min" name="prix_min" min="0" step="0.01" placeholder="50">
          </div>
          <div>
            <label class="champ" for="prix_max">Prix maximum</label>
            <input type="number" id="prix_max" name="prix_max" min="0" step="0.01" placeholder="200">
          </div>
          <div>
            <label class="champ" for="devise">Devise</label>
            <select id="devise" name="devise">
              <option value="USD" selected>USD</option>
              <option value="CDF">CDF</option>
              <option value="EUR">EUR</option>
            </select>
          </div>
        </div>

        <label class="option">
          <input type="checkbox" name="prix_negociable" value="1" checked> Prix négociable
        </label>

        <h2>Modalités</h2>

        <label class="option">
          <input type="checkbox" name="intervention_domicile" value="1"> Je me déplace à domicile
        </label>
        <label class="option">
          <input type="checkbox" name="sur_rendez_vous" value="1"> Sur rendez-vous uniquement
        </label>
        <label class="option">
          <input type="checkbox" name="urgence" value="1"> Disponible pour les urgences
        </label>

        <h2>Contact</h2>

        <div class="ligne">
          <div>
            <label class="champ" for="telephone">Téléphone</label>
            <input type="tel" id="telephone" name="telephone" value="{{ auth.user.telephone || '' }}" placeholder="+243...">
          </div>
          <div>
            <label class="champ" for="email">Email</label>
            <input type="email" id="email" name="email" value="{{ auth.user.email || '' }}" placeholder="contact@exemple.com">
          </div>
        </div>

        <label class="champ" for="site_web">Site web ou page (facultatif)</label>
        <input type="url" id="site_web" name="site_web" placeholder="https://...">

        <h2>Localisation</h2>

        <div class="ligne">
          <div>
            <label class="champ" for="commune">Commune</label>
            <input type="text" id="commune" name="commune" value="{{ auth.user.commune || '' }}" placeholder="Ex : Kampemba">
          </div>
          <div>
            <label class="champ" for="quartier">Quartier</label>
            <input type="text" id="quartier" name="quartier" placeholder="Ex : Bel-Air">
          </div>
        </div>

        <label class="champ" for="adresse">Adresse (facultatif)</label>
        <input type="text" id="adresse" name="adresse" placeholder="Avenue, numéro...">

        <button type="submit">Publier mon offre</button>
      </form>

      <a class="retour" href="{{ route('profil.personnel') }}">← Retour au profil</a>
    </div>
  </div>

@end