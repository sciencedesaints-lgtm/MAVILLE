@component('layouts/main', { title: 'En service - MAVILLE' })

  <style>
    .es-page { min-height: 100vh; background: #0f172a; display: flex; justify-content: center; padding: 32px 16px; box-sizing: border-box; font-family: system-ui, sans-serif; }
    .es-wrap { width: 100%; max-width: 640px; }
    .es-wrap h1 { color: #f8fafc; font-size: 1.5rem; margin: 0 0 6px; }
    .es-sub { color: #94a3b8; font-size: 0.9rem; margin: 0 0 20px; line-height: 1.5; }
    .es-card { background: #1e293b; border: 1px solid #334155; border-radius: 16px; padding: 22px; margin-bottom: 20px; }
    .es-card h2 { color: #38bdf8; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 14px; }
    .es-gros { width: 100%; padding: 18px; border: none; border-radius: 14px; font-size: 1.1rem; font-weight: 800; color: #fff; cursor: pointer; background: linear-gradient(135deg, #10b981, #059669); }
    .es-gros.stop { background: linear-gradient(135deg, #ef4444, #b91c1c); }
    .es-etat { margin: 12px 0 0; font-size: 0.9rem; color: #fbbf24; min-height: 1.2em; }
    .es-avert { color: #fde68a; font-size: 0.82rem; margin: 10px 0 0; line-height: 1.5; }
    .es-ligne { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid #334155; }
    .es-ligne:last-child { border-bottom: none; }
    .es-nom { color: #f8fafc; font-size: 0.95rem; margin: 0; }
    .es-ligne form { margin: 0; }
    .es-btn { padding: 7px 14px; border-radius: 20px; border: 1px solid #475569; background: #0f172a; color: #e2e8f0; font-size: 0.82rem; font-weight: 600; cursor: pointer; }
    .es-btn.on { background: #064e3b; border-color: #10b981; }
    .es-vide { color: #64748b; font-style: italic; }
    .es-retour { display: block; text-align: center; color: #94a3b8; margin-top: 22px; text-decoration: none; font-size: 0.9rem; }
  </style>

  <div class="es-page">
    <div class="es-wrap">
      <h1>🚕 Je suis en service</h1>
      <p class="es-sub">Pour les prestataires qui se déplacent (taxi, livraison, dépannage…). Les clients proches de vous vous trouvent en premier.</p>

      <div class="es-card">
        <h2>Partage de ma position</h2>
        <form id="form-csrf" style="display:none">{{ csrfField() }}</form>
        <button type="button" id="es-bouton" class="es-gros">▶ Commencer mon service</button>
        <p class="es-etat" id="es-etat"></p>
        <p class="es-avert">Votre position est envoyée toutes les 20 secondes tant que cette page reste ouverte et l'écran allumé. Elle est effacée dès que vous arrêtez. Mettez votre téléphone en charge pendant le service.</p>
      </div>

      <div class="es-card">
        <h2>Mes services itinérants</h2>
        @each(s in services)
          <div class="es-ligne">
            <p class="es-nom">{{ s.nom }}</p>
            <form action="/en-service/{{ s.id }}/itinerant" method="POST">
              {{ csrfField() }}
              <button type="submit" class="es-btn {{ s.itinerant ? 'on' : '' }}">{{ s.itinerant ? '🚕 Itinérant : oui' : 'Itinérant : non' }}</button>
            </form>
          </div>
        @else
          <p class="es-vide">Vous n'avez publié aucun service. Utilisez « Proposer mes services » d'abord.</p>
        @end
      </div>

      <a class="es-retour" href="{{ route('profil.personnel') }}">← Retour au profil</a>
    </div>
  </div>

  <script>
    (function () {
      var bouton = document.getElementById('es-bouton')
      var etat = document.getElementById('es-etat')
      var csrf = document.querySelector('#form-csrf input[name="_csrf"]').value
      var minuteur = null
      var actif = false
      var derniere = null

      function envoyer(url, donnees) {
        return fetch(url, {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-TOKEN': csrf },
          body: JSON.stringify(donnees || {}),
        }).then(function (r) { return r.json() })
      }

      function lire() {
        navigator.geolocation.getCurrentPosition(
          function (p) {
            derniere = p
            envoyer('/en-service/position', {
              lat: p.coords.latitude,
              lng: p.coords.longitude,
              precision: p.coords.accuracy,
            }).then(function (res) {
              etat.style.color = res.ok ? '#34d399' : '#f87171'
              etat.textContent = res.ok
                ? '🟢 En service : position envoyée à ' + new Date().toLocaleTimeString('fr-FR') + ' (précision ' + Math.round(p.coords.accuracy) + ' m)'
                : '⚠️ ' + (res.message || 'Position refusée')
            }).catch(function () {
              etat.style.color = '#f87171'
              etat.textContent = 'Connexion perdue, nouvelle tentative…'
            })
          },
          function (err) {
            etat.style.color = '#f87171'
            etat.textContent = err.code === 1
              ? "Position refusée : autorisez la localisation (cadenas de la barre d'adresse)."
              : 'Position indisponible pour le moment…'
          },
          { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 }
        )
      }

      function demarrer() {
        if (!navigator.geolocation) {
          etat.textContent = 'Position non disponible sur ce navigateur.'
          return
        }
        actif = true
        bouton.textContent = '⏹ Arrêter mon service'
        bouton.classList.add('stop')
        etat.style.color = '#fbbf24'
        etat.textContent = '⏳ Recherche de votre position…'
        lire()
        minuteur = setInterval(lire, 20000)
        try { if (navigator.wakeLock) navigator.wakeLock.request('screen') } catch (e) {}
      }

      function arreter() {
        actif = false
        clearInterval(minuteur)
        bouton.textContent = '▶ Commencer mon service'
        bouton.classList.remove('stop')
        etat.style.color = '#94a3b8'
        etat.textContent = 'Service arrêté : votre position a été effacée.'
        envoyer('/en-service/arreter')
      }

      bouton.addEventListener('click', function () { actif ? arreter() : demarrer() })

      // Fermer la page arrête le partage
      window.addEventListener('pagehide', function () {
        if (actif && navigator.sendBeacon) {
          var d = new FormData()
          d.append('_csrf', csrf)
          navigator.sendBeacon('/en-service/arreter', d)
        }
      })
    })()
  </script>

@end