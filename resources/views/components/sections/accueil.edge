<section id="section-accueil" class="app-card active" style="display: flex; flex-direction: column;">
  
  <!-- 1. HEADER / BARRE SUPÉRIEURE -->
  <header class="main-header">
    <div class="header-left">
      <button id="burger-btn" class="burger-menu">☰</button>
      <div class="logo">MA<span>VILLE</span></div>
    </div>

    <div class="header-search">
      <div class="search-input-wrapper">
        <span class="search-icon">🔍</span>
        <input type="text" placeholder="Rechercher un produit, un service, un établissement...">
        <div class="search-actions">
          <button title="Recherche vocale" class="btn-search-opt">🎙️</button>
          <button title="Recherche par image" class="btn-search-opt">📷</button>
        </div>
      </div>
      <button class="btn-search-submit">Rechercher</button>
    </div>

    <div class="header-right">
      <div class="location-badge">📍 <span>Lubumbashi</span></div>
      <div class="lang-selector">🌐 FR</div>
      <button class="icon-btn notifications-btn">🔔 <span class="badge">3</span></button>
      <div class="user-profile">
        <div class="avatar">PK</div>
        <div class="user-info">
          <span class="user-name">Parfait Kamey</span>
          <span class="user-role">Mon compte ▼</span>
        </div>
      </div>
    </div>
  </header>

  <!-- CONTENT CONTAINER -->
  <div class="dashboard-body">

    <!-- 2. BLOC SUPÉRIEUR : GRILLE DES CATÉGORIES + HERO BANNER -->
    <div class="top-grid">
      
      <!-- NAVIGATION PAR CATÉGORIES (Gauche) -->
      <aside class="categories-hub">
        <h3>Services & Catégories</h3>
        <div class="categories-grid">
          <a href="#" class="cat-item">🛍️ <span>Produits</span></a>
          <a href="#" class="cat-item">🔧 <span>Services</span></a>
          <a href="#" class="cat-item">🍴 <span>Restaurants</span></a>
          <a href="#" class="cat-item">💊 <span>Pharmacies</span></a>
          <a href="#" class="cat-item">🎓 <span>Éducation</span></a>
          <a href="#" class="cat-item">🚌 <span>Transport</span></a>
          <a href="#" class="cat-item">🏠 <span>Immobilier</span></a>
          <a href="#" class="cat-item">🏷️ <span>Offres & Promos</span></a>
          <a href="#" class="cat-item">💼 <span>Emplois</span></a>
          <a href="#" class="cat-item">🎪 <span>Événements</span></a>
          <a href="#" class="cat-item">🌱 <span>Agriculture</span></a>
          <a href="#" class="cat-item">🏛️ <span>Vie citoyenne</span></a>
        </div>
        <div class="premium-box">
          <p><strong>Passez Premium</strong></p>
          <small>Plus de visibilité pour vos commerces</small>
          <button class="btn-xs">Découvrir</button>
        </div>
      </aside>

      <!-- HERO BANNER (Droite) -->
      <div class="hero-banner">
        <div class="hero-content">
          <h1>Découvrez tout <br>dans <span>votre ville</span></h1>
          <p>La meilleure façon de vivre votre ville</p>
          
          <div class="hero-filters">
            <button class="filter-btn active">📍 Autour de moi</button>
            <button class="filter-btn">🏙️ Toute la ville</button>
            <button class="filter-btn">🌍 Autre ville / pays</button>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. BARRE DE WIDGETS CLÉS (Météo, Wallet, Carte) -->
    <div class="widgets-row">
      
      <!-- WIDGET METEO -->
      <div class="widget-card weather-widget">
        <div class="widget-header">
          <span>Lubumbashi</span>
          <span class="weather-temp">27°C ☀️</span>
        </div>
        <div class="widget-details">
          <p>🌱 Qualité de l'air: <strong>Bonne</strong></p>
          <p>🚗 Trafic: <strong>Fluide</strong></p>
        </div>
      </div>

      <!-- WIDGET WALLET -->
      <div class="widget-card wallet-widget">
        <div class="widget-header">
          <span>Mon solde MAVILLE</span>
          <strong class="wallet-balance">125,500 FC</strong>
        </div>
        <div class="wallet-actions">
          <button>👛 Portefeuille</button>
          <button>💳 Mes cartes</button>
          <button>🔄 Transferts</button>
        </div>
      </div>

      <!-- WIDGET CARTE -->
      <div class="widget-card map-widget">
        <div class="map-placeholder">
          <span>📍 Carte interactive de Lubumbashi</span>
          <button class="btn-xs">Voir la carte</button>
        </div>
      </div>
    </div>

    <!-- 4. SECTION PROMOTIONS DU JOUR (Chargement Dynamique) -->
    <section class="dashboard-section">
      <div class="section-header">
        <h2>Promotions du jour 🔥</h2>
        <a href="#" class="see-all">Voir tout</a>
      </div>
      <div id="shops-container" class="shops-grid">
        <!-- Les cartes de boutiques seront injectées ici par app.js -->
        <p>Chargement des opportunités...</p>
      </div>
    </section>

    <!-- 5. GRILLE 3 COLONNES : PRIX, SERVICES, ADS -->
    <div class="middle-grid">
      
      <!-- PRIX ESSENTIELS -->
      <div class="info-card">
        <div class="section-header">
          <h3>Prix essentiels aujourd'hui</h3>
          <a href="#" class="see-all">Voir tout</a>
        </div>
        <ul class="prices-list">
          <li><span>🌾 Farine (1kg)</span> <strong>2,000 FC <small class="down">↓ 2%</small></strong></li>
          <li><span>🍾 Huile (1L)</span> <strong>3,500 FC <small class="up">↑ 5%</small></strong></li>
          <li><span>🍬 Sucre (1kg)</span> <strong>2,500 FC <small>0%</small></strong></li>
          <li><span>🌾 Riz (1kg)</span> <strong>2,800 FC <small class="down">↓ 1%</small></strong></li>
        </ul>
      </div>

      <!-- SERVICES POPULAIRES -->
      <div class="info-card">
        <div class="section-header">
          <h3>Services populaires</h3>
          <a href="#" class="see-all">Voir tout</a>
        </div>
        <div class="services-list">
          <div class="service-item">⚡ <span>Électriciens</span> <small>à partir de 15,000 FC</small></div>
          <div class="service-item">🚰 <span>Plombiers</span> <small>à partir de 10,000 FC</small></div>
          <div class="service-item">🚗 <span>Mécaniciens</span> <small>à partir de 20,000 FC</small></div>
        </div>
      </div>

      <!-- BANNIÈRE PUB / BOOST -->
      <div class="info-card boost-card">
        <h3>Boostez votre visibilité 🚀</h3>
        <p>Attirez plus de clients avec nos offres premium.</p>
        <button class="btn-gradient">Voir les offres</button>
      </div>

    </div>

    <!-- 6. BAS DE PAGE (Emplois, Événements, Vie Citoyenne) -->
    <div class="bottom-grid">
      <div class="info-card">
        <h3>💼 Emplois récents</h3>
        <ul>
          <li><strong>Développeur Web</strong> - Tech Solutions</li>
          <li><strong>Comptable</strong> - Enterprise SARL</li>
        </ul>
      </div>

      <div class="info-card">
        <h3>🎪 Événements à venir</h3>
        <ul>
          <li><strong>Concert Fally Ipupa</strong> - Stade TP Mazembe</li>
          <li><strong>Salon de l'Emploi</strong> - Pullman Hotel</li>
        </ul>
      </div>

      <div class="info-card">
        <h3>📢 Vie citoyenne</h3>
        <ul>
          <li>🚨 Signaler un problème en ville</li>
          <li>⚡ Signalement panne d'électricité</li>
        </ul>
      </div>
    </div>

  </div>
</section>