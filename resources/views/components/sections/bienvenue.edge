<section id="bienvenue">
  <header class="main-header">
    <div class="top-bar">
      <div class="logo"><span>MA</span>VILLE</div>

      
    </div>
  </header>

  <div class="menu-overlay" id="menu-overlay"></div>

  <main>
    <h2>Bienvenue sur MAVILLE</h2>
