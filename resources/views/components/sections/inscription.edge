  <main class="main-wrapper">

    {{-- ==========================================================================
         1. FORMULAIRE D'INSCRIPTION (Page Initiale)
         ========================================================================== --}}
    <section class="app-card text-center active" id="section-inscription">
      <div class="logo-card"><span>MA</span>VILLE</div>
      <h2>Créer un compte</h2>
      <p class="subtitle">Rejoignez la communauté de votre ville.</p>

      <form id="form-inscription">
  {{ csrfField() }}

  <div class="form-row">
    <div class="form-group">
      <input type="text" name="nom" id="nom" placeholder="Votre nom" required />
    </div>
    <div class="form-group">
      <input type="text" name="prenom" id="prenom" placeholder="Votre prénom" required />
    </div>
  </div>

  <div class="form-group">
    <select name="genre" id="genre" class="form-control" required>
      <option value="" disabled selected>Genre</option>
      <option value="homme">Homme</option>
      <option value="femme">Femme</option>
    </select>
  </div>

  <div class="form-group">
    <input type="email" name="email" id="email" placeholder="exemple@email.com" autocomplete="email" required />
  </div>

  <div class="form-group">
    <input type="tel" name="telephone" id="telephone" placeholder="+243..." required />
  </div>

  <div class="form-group">
    <input type="text" name="ville" id="ville" value="Lubumbashi" placeholder="Ville" required />
  </div>

  <div class="form-group">
    <div class="password-group">
      <input type="password" name="password" id="signup-password" placeholder="Mot de passe" autocomplete="new-password" required />
      <button type="button" id="toggle-password-signup" class="btn-toggle">👁️</button>
    </div>
  </div>

  <button type="submit" class="btn-gradient" style="margin-top: 15px;">Créer mon compte</button>
</form>
    </section>


    {{-- ==========================================================================
         2. ONBOARDING STEP 1 : LE CONCEPT
         ========================================================================== --}}
    <section id="onboarding-1" class="app-card text-center">
      <div class="logo-card"><span>MA</span>VILLE</div>
      <h2>Le Concept</h2>
      <p class="subtitle">Votre ville à portée de main.</p>

      <div class="onboarding-content">
        <div class="onboarding-icon">🏙️</div>
        <p><strong>MAVILLE</strong> vous permet de découvrir les commerces, événements et services essentiels de votre ville en un seul endroit.</p>
      </div>

      <button type="button" id="btn-onboarding-1" class="btn-gradient">Suivant</button>
    </section>


    {{-- ==========================================================================
         3. ONBOARDING STEP 2 : FONCTIONNALITÉS
         ========================================================================== --}}
    <section id="onboarding-2" class="app-card text-center">
      <div class="logo-card"><span>MA</span>VILLE</div>
      <h2>Ce que vous pouvez faire</h2>
      <p class="subtitle">Des fonctionnalités pensées pour vous.</p>

      <div class="onboarding-content">
        <div class="onboarding-icon">🛍️</div>
        <p>Explorez les boutiques locales, donnez votre avis, profitez des offres exclusives et restez informé de l'actualité de votre quartier.</p>
      </div>

      <button type="button" id="btn-onboarding-2" class="btn-gradient">Suivant</button>
    </section>


    {{-- ==========================================================================
         4. ONBOARDING STEP 3 : CONDITIONS D'UTILISATION (CGU)
         ========================================================================== --}}
    <section id="onboarding-3" class="app-card text-center">
      <div class="logo-card"><span>MA</span>VILLE</div>
      <h2>Conditions d'utilisation</h2>
      <p class="subtitle">Règles de la communauté.</p>

      <div class="onboarding-content cgu-box">
        <p>En utilisant MAVILLE, vous vous engagez à respecter la communauté :</p>
        <ul class="cgu-list">
          <li>✅ Fournir des avis sincères et constructifs.</li>
          <li>✅ Respecter les commerçants et les autres utilisateurs.</li>
          <li>✅ Ne pas publier de contenus illégaux ou trompeurs.</li>
        </ul>
      </div>

      <button type="button" id="btn-onboarding-3" class="btn-gradient">Accepter & Valider</button>
    </section>


    {{-- ==========================================================================
         5. PAGE SUCCÈS & REDIRECTION FINAL
         ========================================================================== --}}
    <section id="succes" class="app-card text-center">
      <div class="logo-card"><span>MA</span>VILLE</div>
      <div class="success-icon">🎉</div>
      <h2>Inscription validée !</h2>
      <p class="subtitle">Bienvenue dans la communauté. Votre compte est maintenant totalement actif.</p>

      <a href="{{ route('home') }}" class="btn-gradient" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
        Continuer vers l'Accueil
      </a>
    </section>

  </main>
